# Copy to .env. The CLI loads it automatically. Never put API keys in frontend code.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_REASONING_EFFORT=low
# Optional per-role overrides. Blank means OPENROUTER_MODEL.
OPENROUTER_POLICY_MODEL=
OPENROUTER_COMPUTER_MODEL=

# Local overlay bridge token, independent from your OpenRouter key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LAST_HOUR_TOKEN=
LAST_HOUR_ORIGIN=http://localhost:3000
LAST_HOUR_DATA=./data

# Study Signal: heart collector and optional fine-tuned tutor
STUDY_HEART_URL=
STUDY_HEART_TOKEN=
STUDY_MODEL_PROVIDER=openrouter
STUDY_MODEL_ID=
STUDY_MODEL_ENDPOINT=http://127.0.0.1:8001/v1
STUDY_MODEL_API_KEY=
HEART_INGEST_TOKEN=
HEART_READ_TOKEN=

# Server transcription via OpenRouter
STUDY_STT_MODEL=openai/whisper-large-v3-turbo

# Local pretrained neural gaze (no GPU server)
STUDY_GAZE_MODEL=unigaze_l16_joint
